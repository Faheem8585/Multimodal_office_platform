# Copy to .env for local dev. In staging/prod, inject these via your secrets
# manager (Vault / AWS Secrets Manager / SOPS) — never commit real secrets.

# --- App ---
ENVIRONMENT=dev                 # dev | staging | prod
DEBUG=true                      # MUST be false in prod
PROJECT_NAME=Office Platform
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO

# --- Security ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-insecure-change-me-32chars!!   # >=32 chars required in prod
ACCESS_TOKEN_TTL_SECONDS=900           # 15 minutes
REFRESH_TOKEN_TTL_SECONDS=1209600      # 14 days
# JSON array of allowed browser origins.
CORS_ORIGINS=["http://localhost:5173","http://localhost:8080"]

# --- Database (PostgreSQL + pgvector) ---
DATABASE_URL=postgresql+asyncpg://office:office@localhost:5432/office
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# --- Redis (cache + Celery broker + rate limiting) ---
REDIS_URL=redis://localhost:6379/0
RATE_LIMIT_DEFAULT=200/minute

# --- Object storage (S3-compatible; MinIO locally) ---
# Leave S3_ENDPOINT_URL empty to use real AWS S3. If unreachable in dev, the
# app falls back to local-disk storage at STORAGE_LOCAL_FALLBACK_DIR.
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=office-documents
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1
STORAGE_LOCAL_FALLBACK_DIR=/tmp/office-storage

# --- AI / RAG ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384
LLM_PROVIDER=anthropic          # anthropic | echo (echo = no-network fallback)
LLM_MODEL=claude-opus-4-8
ANTHROPIC_API_KEY=

# --- Observability (optional) ---
SENTRY_DSN=
OTEL_EXPORTER_ENDPOINT=

# --- Seeding (used by `python -m app.initial_data`) ---
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMe!Admin123
SEED_ON_START=false             # set true to seed on container start (prod compose)

# --- Runtime ---
WEB_CONCURRENCY=4
