# Environment for the single-host production compose stack.
# Copy to `.env` in this directory and fill in real values, then:
#   docker compose -f docker-compose.prod.yml --env-file .env up -d --build

# --- Postgres container ---
POSTGRES_USER=office
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password
POSTGRES_DB=office

# --- App config (consumed by api + worker) ---
ENVIRONMENT=prod
DEBUG=false
JWT_SECRET=CHANGE_ME_generate_a_48_char_urlsafe_secret_value_here
DATABASE_URL=postgresql+asyncpg://office:CHANGE_ME_strong_db_password@db:5432/office
REDIS_URL=redis://redis:6379/0
CORS_ORIGINS=["https://office.example.com"]

# Object storage — point at your S3/MinIO. Empty endpoint => AWS S3.
S3_ENDPOINT_URL=
S3_BUCKET=office-documents
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME
S3_REGION=eu-central-1

# AI
LLM_PROVIDER=anthropic
LLM_MODEL=claude-opus-4-8
ANTHROPIC_API_KEY=CHANGE_ME

# Observability (optional)
SENTRY_DSN=

# Seed admin on first start
SEED_ADMIN_EMAIL=admin@office.example.com
SEED_ADMIN_PASSWORD=CHANGE_ME_admin_password
